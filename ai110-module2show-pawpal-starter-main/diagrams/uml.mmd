classDiagram
    %% PawPal+ class design
    %% Owner has Pets, Pets have CareTasks, the Scheduler turns tasks into a daily plan.

    class Owner {
        +str name
        +int minutes_available
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +list_pets() list
    }

    class Pet {
        +str name
        +str species
        +str breed
        +list~CareTask~ tasks
        +add_task(task) None
        +get_tasks() list
    }

    class CareTask {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +priority_score() int
        +is_high_priority() bool
    }

    class Scheduler {
        +int minutes_available
        +build_plan(tasks) list
        +sort_by_priority(tasks) list
        +explain_plan(plan) str
    }

    Owner "1" --> "many" Pet : owns
    Pet "1" --> "many" CareTask : has
    Scheduler ..> CareTask : schedules
    Scheduler ..> Owner : reads time limit from
