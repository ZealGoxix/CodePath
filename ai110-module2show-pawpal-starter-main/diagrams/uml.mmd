classDiagram
    %% PawPal+ class design
    %% Owner has Pets, Pets have CareTasks, the Scheduler turns tasks into a daily plan.

    class Owner {
        +str name
        +int minutes_available
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +list_pets() list
    }

    class Pet {
        +str name
        +str species
        +str breed
        +list~Task~ tasks
        +add_task(task) None
        +get_tasks() list
        +pending_tasks() list
        +task_count() int
    }

    class Task {
        +str description
        +str time
        +str frequency
        +int duration_minutes
        +str priority
        +str category
        +bool completed
        +mark_complete() None
        +priority_score() int
        +is_high_priority() bool
    }

    class Scheduler {
        +int minutes_available
        +get_tasks_from_owner(owner) list
        +sort_by_priority(pairs) list
        +build_plan(owner) tuple
        +explain_plan(owner) str
    }

    Owner "1" --> "many" Pet : owns
    Pet "1" --> "many" Task : has
    Scheduler ..> Task : schedules
    Scheduler ..> Owner : reads tasks and time from
